<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Sent | VibeCoder</title>
    <!-- Use Tailwind via CDN for the EJS view to maintain the dark aesthetic quickly -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#0f0f11',
                        card: '#12121a',
                        primary: '#8b5cf6',
                        secondary: '#a855f7',
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0f0f11; color: white; font-family: system-ui, sans-serif; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center relative overflow-hidden">
    <!-- Glowing background elements -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-primary rounded-full mix-blend-screen filter blur-[100px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-secondary rounded-full mix-blend-screen filter blur-[100px]"></div>
    </div>

    <div class="z-10 bg-card p-10 rounded-2xl border border-white/10 text-center max-w-md w-full shadow-2xl">
        <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
        </div>
        <h1 class="text-3xl font-bold mb-4">Message Sent!</h1>
        <p class="text-gray-400 mb-8">Thanks for reaching out, <span class="text-white font-semibold"><%= name %></span>. I've received your message and will get back to you shortly.</p>
        
        <!-- Redirects back to the React app -->
        <a href="http://localhost:5173" class="inline-block bg-primary hover:bg-secondary text-white font-semibold py-3 px-8 rounded-lg transition-all shadow-[0_0_15px_rgba(139,92,246,0.4)]">
            Return to Portfolio
        </a>
    </div>
</body>
</html>
